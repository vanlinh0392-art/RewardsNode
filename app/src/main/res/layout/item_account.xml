<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootItemAccount"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_profile_card_dark"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Row 1: Email & Level / Streak Badges + Switch Enabled -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/layoutAccountHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/switchAccountEnabled"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAccountEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:ellipsize="middle"
                android:singleLine="true"
                android:text="user@outlook.com"
                android:textColor="#F8FAFC"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Sub Badges: Level & Streak -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvAccountLevelBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_dark"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="Lv.2 • 0 pts"
                    android:textColor="#38BDF8"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAccountStreak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_badge_gold"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="🔥 0"
                    android:textColor="@color/badge_gold"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- Switch on/off góc phải trên -->
        <Switch
            android:id="@+id/switchAccountEnabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:checked="true" />

    </RelativeLayout>

    <!-- Row 2: Checklist 5 Micro-Badges Cluster -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvPcBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_pill_dark"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="0/90"
            android:textColor="#10B981"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMobBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_pill_dark"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="0/60"
            android:textColor="#06B6D4"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEdgeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_pill_dark"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="0/12"
            android:textColor="#F59E0B"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDailySetBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_pill_dark"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="0/3"
            android:textColor="#818CF8"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvClaimBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_dark"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="Đã nhận ✓"
            android:textColor="#34D399"
            android:textSize="10sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Row 3: Proxy Chip & Thin Progress Bar + Delta Today -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvProxyChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_dark"
            android:ellipsize="end"
            android:maxWidth="130dp"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:singleLine="true"
            android:text="🛡️ Trực tiếp"
            android:textColor="#94A3B8"
            android:textSize="10sp" />

        <ProgressBar
            android:id="@+id/pbAccountProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:max="35"
            android:progress="0"
            android:progressBackgroundTint="#1E293B"
            android:progressTint="#10B981" />

        <TextView
            android:id="@+id/tvDeltaToday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_pill_dark"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="+0 hôm nay"
            android:textColor="#A855F7"
            android:textSize="10sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Row 4: Compact Action Buttons (28dp micro-buttons) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDeleteAccount"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/bg_micro_pill_err"
            android:minWidth="0dp"
            android:minHeight="28dp"
            android:paddingHorizontal="8dp"
            android:stateListAnimator="@null"
            android:text="Xóa nick"
            android:textAllCaps="false"
            android:textColor="@color/pill_err"
            android:textSize="10sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnRunSingle"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_micro_pill_all"
            android:minWidth="0dp"
            android:minHeight="28dp"
            android:paddingHorizontal="8dp"
            android:stateListAnimator="@null"
            android:text="▶ Chạy"
            android:textAllCaps="false"
            android:textColor="#10B981"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnRefreshPoints"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_micro_pill_net"
            android:minWidth="0dp"
            android:minHeight="28dp"
            android:paddingHorizontal="8dp"
            android:stateListAnimator="@null"
            android:text="🔄 Cập nhật"
            android:textAllCaps="false"
            android:textColor="#38BDF8"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnEditProxy"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_micro_pill_net"
            android:minWidth="0dp"
            android:minHeight="28dp"
            android:paddingHorizontal="8dp"
            android:stateListAnimator="@null"
            android:text="Proxy"
            android:textAllCaps="false"
            android:textColor="@color/pill_net"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAuth"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/bg_micro_pill_all"
            android:minWidth="0dp"
            android:minHeight="28dp"
            android:paddingHorizontal="8dp"
            android:stateListAnimator="@null"
            android:text="Đăng nhập lại"
            android:textAllCaps="false"
            android:textColor="@color/edge_blue"
            android:textSize="10sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Legacy Views for Zero-Crash Compatibility -->
    <TextView android:id="@+id/tvBasketPc" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/tvBasketMobile" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/tvBasketEdge" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/tvAccountProgress" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/tvAccountProxy" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

</LinearLayout>
