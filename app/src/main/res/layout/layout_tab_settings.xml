<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootTabSettings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical">

    <!-- Top Header (Dark OLED HUD) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="18dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cài Đặt"
            android:textColor="#F8FAFC"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_dark"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="OLED Dark"
            android:textColor="#10B981"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Deck Zone with bg_thumb_deck -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_thumb_deck"
        android:orientation="vertical">

        <!-- Scrollable Settings Container -->
        <ScrollView
            android:id="@+id/scrollSettingsContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="20dp">

                <!-- Card 1: Cooldown Settings -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_profile_card_dark"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Điều Nhịp Cooldown (Phút)"
                        android:textColor="#F8FAFC"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Nghỉ ngẫu nhiên giữa các batch tìm kiếm"
                        android:textColor="#64748B"
                        android:textSize="12sp" />

                    <!-- Min & Max Cooldown Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <!-- Cooldown Min -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tối thiểu (Min):"
                                android:textColor="#94A3B8"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <EditText
                                android:id="@+id/etCooldownMin"
                                android:layout_width="match_parent"
                                android:layout_height="42dp"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/bg_pill_dark"
                                android:hint="15"
                                android:inputType="number"
                                android:paddingHorizontal="12dp"
                                android:text="15"
                                android:textColor="#F8FAFC"
                                android:textColorHint="#64748B"
                                android:textSize="13sp" />

                        </LinearLayout>

                        <!-- Cooldown Max -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tối đa (Max):"
                                android:textColor="#94A3B8"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <EditText
                                android:id="@+id/etCooldownMax"
                                android:layout_width="match_parent"
                                android:layout_height="42dp"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/bg_pill_dark"
                                android:hint="22"
                                android:inputType="number"
                                android:paddingHorizontal="12dp"
                                android:text="22"
                                android:textColor="#F8FAFC"
                                android:textColorHint="#64748B"
                                android:textSize="13sp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <!-- Card 2: Target Searches Settings -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_profile_card_dark"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hạn Mức Tìm Kiếm"
                        android:textColor="#F8FAFC"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Mục tiêu ngày:"
                            android:textColor="#94A3B8"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etDefaultTargetSearches"
                            android:layout_width="80dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_pill_dark"
                            android:gravity="center"
                            android:hint="35"
                            android:inputType="number"
                            android:text="35"
                            android:textColor="#F8FAFC"
                            android:textColorHint="#64748B"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <!-- Presets: 15, 30, 35, 50, 60 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnPreset15"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pill_srch"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:padding="0dp"
                            android:stateListAnimator="@null"
                            android:text="15"
                            android:textColor="@color/pill_srch"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnPreset30"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pill_srch"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:padding="0dp"
                            android:stateListAnimator="@null"
                            android:text="30"
                            android:textColor="@color/pill_srch"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnPreset35"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pill_all"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:padding="0dp"
                            android:stateListAnimator="@null"
                            android:text="35"
                            android:textColor="@color/edge_blue"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnPreset50"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pill_srch"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:padding="0dp"
                            android:stateListAnimator="@null"
                            android:text="50"
                            android:textColor="@color/pill_srch"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnPreset60"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pill_srch"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:padding="0dp"
                            android:stateListAnimator="@null"
                            android:text="60"
                            android:textColor="@color/pill_srch"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Switch Apply to All Accounts -->
                    <Switch
                        android:id="@+id/swApplyTargetToAll"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="8dp"
                        android:text="Áp dụng cho tất cả tài khoản"
                        android:textColor="#F8FAFC"
                        android:textSize="13sp" />

                </LinearLayout>

                <!-- Card 3: Global Proxy -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_profile_card_dark"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Proxy Toàn Cục"
                        android:textColor="#F8FAFC"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Dự phòng cho profile không có proxy riêng"
                        android:textColor="#64748B"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/etGlobalProxy"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_pill_dark"
                        android:hint="socks5://user:pass@host:port"
                        android:inputType="textUri"
                        android:paddingHorizontal="12dp"
                        android:textColor="#F8FAFC"
                        android:textColorHint="#64748B"
                        android:textSize="13sp" />

                </LinearLayout>

                <!-- Card 4: User-Agent Customization -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_profile_card_dark"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="User-Agent Di Động"
                        android:textColor="#F8FAFC"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etUserAgent"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_pill_dark"
                        android:hint="Mozilla/5.0 (Linux; Android 14)..."
                        android:inputType="text"
                        android:paddingHorizontal="12dp"
                        android:textColor="#F8FAFC"
                        android:textColorHint="#64748B"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- Card 5: Telegram Bot Notifications -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_profile_card_dark"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thông Báo Telegram"
                        android:textColor="#F8FAFC"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Báo cáo tiến độ và cảnh báo Captcha tức thời"
                        android:textColor="#64748B"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/etTelegramBotToken"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_pill_dark"
                        android:hint="Bot Token"
                        android:inputType="text"
                        android:paddingHorizontal="12dp"
                        android:textColor="#F8FAFC"
                        android:textColorHint="#64748B"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etTelegramChatId"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_pill_dark"
                        android:hint="Chat ID"
                        android:inputType="text"
                        android:paddingHorizontal="12dp"
                        android:textColor="#F8FAFC"
                        android:textColorHint="#64748B"
                        android:textSize="13sp" />

                    <!-- Test Telegram Button -->
                    <Button
                        android:id="@+id/btnTestTelegram"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_pill_all"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="14dp"
                        android:stateListAnimator="@null"
                        android:text="Gửi tin thử nghiệm"
                        android:textColor="@color/edge_blue"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Card 6: Dark Mode & Device Health -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_profile_card_dark"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Giao Diện &amp; Bảo Vệ Thiết Bị"
                        android:textColor="#F8FAFC"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <!-- Dark Mode Switch -->
                    <Switch
                        android:id="@+id/swDarkMode"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="4dp"
                        android:checked="true"
                        android:text="Chế độ Tối (Dark Mode Amoled)"
                        android:textColor="#F8FAFC"
                        android:textSize="13sp" />

                    <!-- Wifi Only Switch -->
                    <Switch
                        android:id="@+id/swWifiOnly"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="Chỉ chạy qua Wi-Fi"
                        android:textColor="#F8FAFC"
                        android:textSize="13sp" />

                    <!-- Battery Guard Switch -->
                    <Switch
                        android:id="@+id/swBatteryGuard"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:checked="true"
                        android:text="Dừng khi pin &lt; 20%"
                        android:textColor="#F8FAFC"
                        android:textSize="13sp" />

                    <!-- Battery Optimization Exemption Button -->
                    <Button
                        android:id="@+id/btnBatteryOptimization"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_pill_net"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="14dp"
                        android:stateListAnimator="@null"
                        android:text="Bỏ qua Tối ưu Pin (24/7)"
                        android:textColor="@color/success"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

        <!-- Sticky Button Bar at Bottom (OLED Dark, padding bottom 76dp so it hovers above Floating Dock) -->
        <LinearLayout
            android:id="@+id/stickyBottomSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0B1120"
            android:elevation="8dp"
            android:paddingHorizontal="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="76dp">

            <Button
                android:id="@+id/btnSaveSettings"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_btn_primary"
                android:stateListAnimator="@null"
                android:text="Lưu Cấu Hình Cài Đặt"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
